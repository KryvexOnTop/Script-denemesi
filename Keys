local FPS = 0
local FrameCount = 0
local LastFPSTime = os.clock()

RunService.RenderStepped:Connect(function()

    FrameCount += 1

    local Now = os.clock()

    if Now - LastFPSTime >= 1 then

        FPS = FrameCount
        FrameCount = 0
        LastFPSTime = Now

        if AntiAfkEnabled then
            FPSLabel.Text = "FPS: " .. FPS
        end

    end

end)


